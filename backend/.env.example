# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# Two long random secrets. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CODE_SECRET=

# Neon Postgres connection string (Neon dashboard -> Connect -> choose "Pooled connection").
# It looks like: postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# true  = only ONE owner can ever register (matches the app). Others get "sign up closed".
# false = anyone can register (use this for multi-shop SaaS).
OWNER_ONLY=true

# Set to the number of reverse proxies in front of the server (nginx/Render/Railway = 1)
# so rate limits see the real client IP. Leave 0 if none.
TRUST_PROXY=0

# --- Email (required in production) ---
# Any SMTP provider: Resend, Postmark, Amazon SES, Mailgun, Gmail app password...
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ShopDesk <no-reply@yourdomain.com>"
