{
  "name": "shopdesk-server",
  "version": "1.0.0",
  "private": true,
  "description": "Auth backend for the ShopDesk Flutter app: sign up, email codes, sign in, password reset.",
  "type": "module",
  "main": "src/local.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/local.js",
    "dev": "node --watch --env-file-if-exists=.env src/local.js",
    "test": "node --test --no-warnings \"test/*.test.js\""
  },
  "dependencies": {
    "@vercel/functions": "~3.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "embedded-postgres": "^18.6.0-beta.19"
  }
}
