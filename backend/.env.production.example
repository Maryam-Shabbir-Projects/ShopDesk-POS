# Copy to .env on the server. Never commit it.
NODE_ENV=production

# Your API address. Its DNS "A record" must point at this server's IP.
API_DOMAIN=api.yourshop.com

# Two DIFFERENT random strings. Make each with:
#   openssl rand -hex 48
JWT_SECRET=
CODE_SECRET=

# Neon Postgres connection string (Neon dashboard -> Connect -> choose "Pooled connection").
# It looks like: postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Only one owner can ever register (matches the app).
OWNER_ONLY=true

# Email sender (required). Use a transactional provider with a verified domain.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ShopDesk <no-reply@yourshop.com>"
